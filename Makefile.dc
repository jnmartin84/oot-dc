    $(BUILD_DIR)/src/libultra/os/thread.o \
    $(BUILD_DIR)/src/libultra/os/timerintr.o \
    $(BUILD_DIR)/src/libultra/os/virtualtophysical.o \
    $(BUILD_DIR)/src/libultra/os/yieldthread.o \
    $(BUILD_DIR)/src/libultra/reg/_getcount.o \
    $(BUILD_DIR)/src/libultra/reg/_setcompare.o \
    $(BUILD_DIR)/src/linux/reimpl.o \
    $(BUILD_DIR)/src/dreamcast/dc_audio.o \
    $(BUILD_DIR)/src/dreamcast/main.o

ALL_OBJECTS := $(OBJECTS) $(OVERLAY_OBJECTS)

all: $(TARGET)

assets:
	python3 pc_tools/dc_assets.py

# AICA voice driver: regenerate the ADPCM pool (assets_dc/adpcm_pool.bin, loaded
# at runtime) + sample table from the soundfont banks (timestamp-gated; only
# re-runs when the banks change).
# Use the project venv (matches the main Makefile's PYTHON := $(VENV)/bin/python3).
# The AICA transcoder REQUIRES scipy/numpy from requirements.txt; system python
# silently produces broken sampled audio. Override with `make PYTHON=... ` if needed.
PYTHON ?= .venv/bin/python3
# Bake the software reverb into the sample pool. The "known good" shipping table was
# built with this ON; default 1 reproduces it. `make AICA_REVERB=0` for dry samples.
AICA_REVERB ?= 1
AICA_TOOLS := $(wildcard tools/aica/*.py) tools/aica/audio_tables.json

src/audio/internal/aica_sample_table.c: assets_dc/Audiobank.bin assets_dc/Audiotable.bin $(AICA_TOOLS)
	AICA_REVERB=$(AICA_REVERB) PYTHONPATH=tools/aica $(PYTHON) tools/aica/emit_table.py \
		--audiobank assets_dc/Audiobank.bin --audiotable assets_dc/Audiotable.bin \
		--tables tools/aica/audio_tables.json \
		--outdir src/audio/internal --incdir src/audio/internal --pool assets_dc/adpcm_pool.bin

# emitted together with aica_sample_table.c by the one recipe above
src/audio/internal/aica_sample_table.h assets_dc/adpcm_pool.bin: src/audio/internal/aica_sample_table.c
	@touch $@

# aica_synth.c #includes the generated header
$(BUILD_DIR)/src/audio/internal/aica_synth.o: src/audio/internal/aica_sample_table.h

# Force linker to keep audio table entries (--gc-sections would drop them as "unreferenced")
KEEP_AUDIO := -Wl,--undefined=_sSequenceTableEntries \
              -Wl,--undefined=_sSoundFontTableEntries \
              -Wl,--undefined=_sSampleBankTableEntries

$(TARGET): $(ALL_OBJECTS) assets_dc/adpcm_pool.bin | check-assets
	kos-cc $(ALL_OBJECTS) -o $(TARGET) $(ASSET_SYMBOLS) $(KEEP_AUDIO) $(LIBS) $(LTO_FLAGS)


check-assets:
	@if [ -z "$(ASSET_ELFS)" ]; then \
		echo "Error: No asset ELFs found. Run 'make assets' first."; \
		exit 1; \
	fi
	@if [ ! -f "$(ASSET_DIR)/segments.elf" ]; then \
		echo "Error: segments.elf not found. Run 'make assets' first."; \
		exit 1; \
	fi

# Core game code + DC renderer - O3 for speed
$(BUILD_DIR)/src/code/%.o: src/code/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -Os -c $< -o $@

$(BUILD_DIR)/src/dreamcast/%.o: src/dreamcast/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

# GCC ICE with -Os -flto (gen_reg_rtx, emit-rtl.cc:1177)
$(BUILD_DIR)/src/overlays/actors/ovl_En_Ganon_Mant/z_en_ganon_mant.o: src/overlays/actors/ovl_En_Ganon_Mant/z_en_ganon_mant.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

$(BUILD_DIR)/src/overlays/actors/ovl_En_Am/z_en_am.o: src/overlays/actors/ovl_En_Am/z_en_am.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

$(BUILD_DIR)/src/overlays/actors/ovl_En_Bird/z_en_bird.o: src/overlays/actors/ovl_En_Bird/z_en_bird.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

# GCC 14.3 LTO ICEs at LINK time in the libultra libc long-double printf support
# (xprintf.c: expand_ifn_va_arg_1 tree-stdarg.cc:1037; xldtob.c:
# emit_library_call_value_1 calls.cc:4305) once they land in an ltrans partition;
# partition-dependent, so they appear/disappear with unrelated edits. Nothing here
# is hot -- keep the whole dir out of LTO (trailing -fno-lto wins over kos-cc's
# -flto=auto).
$(BUILD_DIR)/src/libultra/libc/%.o: src/libultra/libc/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@ -fno-lto

# Audio code - O3 for performance 
$(BUILD_DIR)/src/audio/game/%.o: src/audio/game/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

$(BUILD_DIR)/src/audio/internal/%.o: src/audio/internal/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -O2 -c $< -o $@

# Audio table files must be compiled without LTO to prevent GC of entries arrays
$(BUILD_DIR)/src/audio/tables/%.o: src/audio/tables/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -fno-lto -c $< -o $@

$(BUILD_DIR)/src/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR)/src $(TARGET) 

clean-assets:
	rm -rf $(ASSET_DIR) assets_dc

clean-all: clean clean-assets

.PHONY: all clean clean-assets clean-all assets check-assets
