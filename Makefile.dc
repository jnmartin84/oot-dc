# Makefile.dc - Dreamcast build using KallistiOS

include $(KOS_BASE)/Makefile.rules

CC := kos-cc
# LTO knob. The sourced KOS env injects -flto=auto through kos-cc (placed BEFORE our
# args), so LTO=0 appends a trailing -fno-lto (GCC: last flag wins) to compile AND
# link. Default 1 = the normal LTO build. `make -f Makefile.dc LTO=0` to bisect.
LTO ?= 1
LTO_FLAGS := $(if $(filter 0,$(LTO)),-fno-lto,)

CFLAGS := -Os -flto -Wall -std=gnu23 -DLINUX -D_LANGUAGE_C -DOOT_VERSION=GC_EU_MQ_DBG \
    -DPLATFORM_GC=1 -DPLATFORM_N64=0 -DPLATFORM_IQUE=0 \
    -DOOT_REVISION=15 -DOOT_REGION=REGION_EU \
    -DLIBULTRA_VERSION=LIBULTRA_VERSION_L -DLIBULTRA_PATCH=0 \
    -DF3DEX_GBI_2 -DF3DEX_GBI_PL -DGBI_DOWHILE -DGBI_DEBUG \
    -DDEBUG_FEATURES=1 -DNON_MATCHING -DAVOID_UB -DMML_VERSION=MML_VERSION_OOT \
    -DBUILD_CREATOR='"zelda@srd022j"' -DBUILD_DATE='"03-02-21"' \
    -DBUILD_TIME='"00:16:31"' \
    -DREGION_JP=0 -DREGION_US=1 -DREGION_EU=2 -DREGION_NULL=255 \
    -Wno-incompatible-pointer-types -Wno-int-conversion \
    -g1 -fno-toplevel-reorder -fwrapv -Wstrict-overflow=3 \
    -Iinclude -Iinclude/dcaudio -Isrc -I. -Iextracted/gc-eu-mq-dbg -Ibuild/gc-eu-mq-dbg
CFLAGS += $(LTO_FLAGS)

#    -DRENDER_240P=1 


BUILD_DIR := build_dc
ASSET_DIR := build_dc/assets
TARGET := zelda.elf
LIBS := -lm -lsh4zam

OVERLAY_SRCS := $(filter-out %.inc.c %/z_map_mark_data.c %/z_lmap_mark_data.c,$(wildcard src/overlays/*/*/*.c))
OVERLAY_OBJECTS := $(patsubst src/%.c,$(BUILD_DIR)/src/%.o,$(OVERLAY_SRCS))

ASSET_ELFS := $(wildcard $(ASSET_DIR)/*.elf)
ASSET_SYMBOLS := $(foreach elf,$(ASSET_ELFS),-Wl,--just-symbols=$(elf))

OBJECTS := \
